# Python & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env
.env.local

# Node / Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
npm-debug.log*

# Ignore temporary markdown exports & helper scripts
backend/cache/extract_structure.py

# Ignore heavy raw SAPM FITS (79 MB), duplicate Zarr chunks (288 files) & unused exposure_index (102 folders)
backend/cache/sapm/
backend/cache/r2_staging/zarr/
backend/cache/r2_staging/exposure_index/

# Explicitly KEEP the 22 real NASA .bin cubes, 20 GeoParquet SED tables & ONNX models!
!backend/cache/r2_staging/cubes/
!backend/cache/r2_staging/cubes/*.bin
!backend/cache/r2_staging/forced_photometry/
!backend/cache/r2_staging/forced_photometry/**/*.parquet
!frontend/public/models/*.onnx

