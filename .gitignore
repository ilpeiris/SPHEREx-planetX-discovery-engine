@"
# Python & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# Ignore heavy raw SAPM matrices (79 MB) & duplicate Zarr chunks (288 files) in Git
# (They stay on your local disk for scripts, but don't bloat GitHub)
backend/cache/sapm/
backend/cache/r2_staging/zarr/


frontend/src//ts-to-md-for-gemini

# Explicitly KEEP the real NASA .bin cubes and GeoParquet SED tables!
!backend/cache/r2_staging/cubes/
!backend/cache/r2_staging/cubes/*.bin
!backend/cache/r2_staging/forced_photometry/
!backend/cache/r2_staging/exposure_index/
!frontend/public/models/*.onnx

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
"@ | Set-Content -Path ".gitignore" -Encoding UTF8